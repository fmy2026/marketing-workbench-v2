<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hys.marketing-workbench-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/hys/Projects/marketing-workbench-v2/deploy/backup-postgres.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/hys/Projects/marketing-workbench-v2</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>20</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/hys/Projects/marketing-workbench-v2/.local/logs/backup.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/hys/Projects/marketing-workbench-v2/.local/logs/backup.stderr.log</string>
</dict>
</plist>
